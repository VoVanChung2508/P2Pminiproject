MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=network_monitor
MYSQL_CREATE_DATABASE=false

# Administrative token for privileged operations (process termination, client disconnect).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Configure the same value on the server and each managed client.
# Keep it secret; do not commit the real value.
MONITOR_ADMIN_TOKEN=your-random-admin-token-here
